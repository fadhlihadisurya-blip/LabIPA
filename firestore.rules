rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Chemicals Collection
    match /chemicals/{chemicalId} {
      allow read: if true;
      allow create, update: if isValidId(chemicalId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 50
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0;
      allow delete: if isValidId(chemicalId);
    }

    // Equipment Collection
    match /equipment/{equipmentId} {
      allow read: if true;
      allow create, update: if isValidId(equipmentId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 50
        && request.resource.data.totalCount is number
        && request.resource.data.totalCount >= 0;
      allow delete: if isValidId(equipmentId);
    }

    // Equipment Borrows Collection
    match /borrows/{borrowId} {
      allow read: if true;
      allow create: if isValidId(borrowId)
        && request.resource.data.borrowerName is string
        && request.resource.data.borrowerName.size() > 0
        && request.resource.data.borrowerName.size() <= 150
        && request.resource.data.equipmentId is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.status is string;
      allow update: if isValidId(borrowId)
        && request.resource.data.status in ['Menunggu Persetujuan', 'Dipinjam', 'Kembali (Baik)', 'Kembali (Rusak/Pecah)', 'Ditolak'];
      allow delete: if isValidId(borrowId);
    }

    // Visits Collection
    match /visits/{visitId} {
      allow read: if true;
      allow create: if isValidId(visitId)
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.teacherName.size() <= 150
        && request.resource.data.practicumTitle is string
        && request.resource.data.practicumTitle.size() > 0
        && request.resource.data.status is string;
      allow update: if isValidId(visitId)
        && request.resource.data.status in ['Menunggu Persetujuan', 'Disetujui', 'Ditolak', 'Selesai'];
      allow delete: if isValidId(visitId);
    }

    // Chemical Requests Collection
    match /chemical_requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId)
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.practicumTitle is string
        && request.resource.data.items is list
        && request.resource.data.status is string;
      allow update: if isValidId(requestId)
        && request.resource.data.status in ['Menunggu Persetujuan', 'Disetujui', 'Ditolak', 'Selesai'];
      allow delete: if isValidId(requestId);
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if isValidId(teacherId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isValidId(teacherId);
      allow delete: if isValidId(teacherId);
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if true;
      allow create: if isValidId(studentId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isValidId(studentId);
      allow delete: if isValidId(studentId);
    }

    // Health check test collection
    match /test/{testId} {
      allow read: if true;
    }
  }
}
